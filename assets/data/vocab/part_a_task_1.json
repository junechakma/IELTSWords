{
  "id": "A",
  "slug": "task-1",
  "title": "Task 1 Vocabulary",
  "subtitle": "Academic: graphs, charts and tables",
  "sections": [
    {
      "id": "A1",
      "title": "Introducing the Visual",
      "entries": [
        {
          "id": "a1-illustrates",
          "type": "word",
          "term": "illustrates",
          "replaces": "shows",
          "example": "The line graph illustrates changes in migration to the US in the 1990s."
        },
        {
          "id": "a1-depicts",
          "type": "word",
          "term": "depicts",
          "replaces": "shows",
          "example": "The bar chart depicts household spending in four countries."
        },
        {
          "id": "a1-gives",
          "type": "word",
          "term": "gives",
          "variants": [
            "provides information about"
          ],
          "replaces": "shows",
          "example": "The table provides information about energy use by sector."
        },
        {
          "id": "a1-compares",
          "type": "word",
          "term": "compares",
          "replaces": "shows",
          "example": "The pie charts compare the sources of electricity in 2000 and 2020."
        },
        {
          "id": "a1-presents",
          "type": "word",
          "term": "presents",
          "replaces": "shows",
          "example": "The diagram presents the stages of paper recycling."
        },
        {
          "id": "a1-reveals",
          "type": "word",
          "term": "reveals",
          "variants": [
            "indicates"
          ],
          "replaces": "shows",
          "example": "The data reveal a clear rise in online sales."
        }
      ]
    },
    {
      "id": "A2",
      "title": "Upward Movement",
      "entries": [
        {
          "id": "a2-increase",
          "type": "word",
          "term": "increase",
          "pos": "v/n",
          "synonyms": [
            "rise",
            "grow",
            "climb"
          ],
          "example": "The number of part-time jobs increased significantly over the decade."
        },
        {
          "id": "a2-surge",
          "type": "word",
          "term": "surge",
          "pos": "v/n",
          "synonyms": [
            "jump",
            "leap"
          ],
          "example": "There was a surge in car ownership after 2010."
        },
        {
          "id": "a2-soar",
          "type": "word",
          "term": "soar",
          "variants": [
            "rocket"
          ],
          "synonyms": [
            "rise very sharply"
          ],
          "example": "Online sales soared to 8 million units."
        },
        {
          "id": "a2-uptick",
          "type": "word",
          "term": "uptick",
          "pos": "n",
          "synonyms": [
            "slight increase"
          ],
          "example": "There was a small uptick in insurance sales in the final year."
        },
        {
          "id": "a2-peak",
          "type": "word",
          "term": "peak",
          "pos": "v/n",
          "synonyms": [
            "reach the highest point"
          ],
          "example": "Visitor numbers peaked at 2 million in July."
        },
        {
          "id": "a2-double",
          "type": "word",
          "term": "double",
          "variants": [
            "triple"
          ],
          "synonyms": [
            "increase twofold / threefold"
          ],
          "example": "Car production doubled between 2000 and 2010."
        },
        {
          "id": "a2-expand",
          "type": "word",
          "term": "expand",
          "synonyms": [
            "grow"
          ],
          "example": "The service sector expanded steadily."
        },
        {
          "id": "a2-recover",
          "type": "word",
          "term": "recover",
          "variants": [
            "revive"
          ],
          "synonyms": [
            "return to a previous level"
          ],
          "example": "Exports recovered after the 2008 downturn."
        },
        {
          "id": "a2-escalate",
          "type": "word",
          "term": "escalate",
          "synonyms": [
            "rise sharply (often costs",
            "problems)"
          ],
          "example": "Housing costs escalated in the final five years."
        }
      ]
    },
    {
      "id": "A3",
      "title": "Downward Movement",
      "entries": [
        {
          "id": "a3-decrease",
          "type": "word",
          "term": "decrease",
          "pos": "v/n",
          "synonyms": [
            "fall",
            "drop",
            "decline"
          ],
          "example": "Average rainfall decreased gradually after 2015."
        },
        {
          "id": "a3-plummet",
          "type": "word",
          "term": "plummet",
          "variants": [
            "plunge"
          ],
          "synonyms": [
            "fall very sharply"
          ],
          "example": "Coal consumption plummeted to just 5%."
        },
        {
          "id": "a3-dip",
          "type": "word",
          "term": "dip",
          "pos": "v/n",
          "synonyms": [
            "slight drop"
          ],
          "example": "There was a slight dip in sales in March."
        },
        {
          "id": "a3-contract",
          "type": "word",
          "term": "contract",
          "variants": [
            "shrink"
          ],
          "synonyms": [
            "become smaller"
          ],
          "example": "The manufacturing sector contracted by a third."
        },
        {
          "id": "a3-halve",
          "type": "word",
          "term": "halve",
          "synonyms": [
            "fall by 50%"
          ],
          "example": "Pollution levels halved over the period."
        },
        {
          "id": "a3-downturn",
          "type": "word",
          "term": "downturn",
          "pos": "n",
          "synonyms": [
            "decline (often economic)"
          ],
          "example": "The figures show a sharp downturn in 2009."
        },
        {
          "id": "a3-subside",
          "type": "word",
          "term": "subside",
          "synonyms": [
            "decrease after a high"
          ],
          "example": "Demand subsided after the peak season."
        },
        {
          "id": "a3-hit-a-trough",
          "type": "word",
          "term": "hit a trough",
          "synonyms": [
            "reach the lowest point"
          ],
          "example": "Unemployment hit a trough of 3% in 2019."
        }
      ]
    },
    {
      "id": "A4",
      "title": "No Change and Irregular Change",
      "entries": [
        {
          "id": "a4-remain-steady",
          "type": "word",
          "term": "remain steady",
          "synonyms": [
            "remain stable / constant / unchanged"
          ],
          "example": "The unemployment rate remained steady at 5%."
        },
        {
          "id": "a4-level-off",
          "type": "word",
          "term": "level off",
          "synonyms": [
            "plateau",
            "stabilise"
          ],
          "example": "Growth levelled off after 2012."
        },
        {
          "id": "a4-reach-a-plateau",
          "type": "word",
          "term": "reach a plateau",
          "synonyms": [
            "stop changing after a rise"
          ],
          "example": "Sales reached a plateau at around 500 units."
        },
        {
          "id": "a4-hover-around",
          "type": "word",
          "term": "hover around",
          "synonyms": [
            "stay close to"
          ],
          "example": "The success rate hovered around 10%."
        },
        {
          "id": "a4-fluctuate-v",
          "type": "word",
          "term": "fluctuate (v)",
          "variants": [
            "fluctuation"
          ],
          "pos": "n",
          "synonyms": [
            "vary"
          ],
          "example": "Prices fluctuated between $10 and $15."
        },
        {
          "id": "a4-erratic",
          "type": "word",
          "term": "erratic",
          "variants": [
            "volatile"
          ],
          "synonyms": [
            "irregular",
            "unstable"
          ],
          "example": "Share prices were highly volatile in 2020."
        },
        {
          "id": "a4-oscillate",
          "type": "word",
          "term": "oscillate",
          "synonyms": [
            "move up and down repeatedly"
          ],
          "example": "Temperatures oscillated between 2°C and 8°C."
        }
      ]
    },
