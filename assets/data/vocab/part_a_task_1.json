        "a marginal difference",
        "a significant difference"
      ]
    },
    {
      "id": "A6",
      "title": "Proportions and Numbers",
      "entries": [
        {
          "id": "a6-account-for",
          "type": "word",
          "term": "account for",
          "meaning": "make up, constitute, represent",
          "example": "The service sector accounted for nearly 50% of employment."
        },
        {
          "id": "a6-proportion",
          "type": "word",
          "term": "proportion",
          "variants": [
            "share"
          ],
          "meaning": "part of a whole",
          "example": "A large proportion of students preferred practical courses."
        },
        {
          "id": "a6-the-majority-of",
          "type": "word",
          "term": "the majority of",
          "meaning": "most",
          "example": "The majority of consumers chose online shopping."
        },
        {
          "id": "a6-a-minority-of",
          "type": "word",
          "term": "a minority of",
          "meaning": "a small part",
          "example": "Only a minority of commuters used the metro."
        },
        {
          "id": "a6-half",
          "type": "word",
          "term": "half",
          "variants": [
            "a quarter",
            "a third"
          ],
          "meaning": "50% / 25% / 33%",
          "example": "A quarter of the budget went on housing."
        },
        {
          "id": "a6-twice-as-much",
          "type": "word",
          "term": "twice as much",
          "variants": [
            "many as"
          ],
          "meaning": "two times",
          "example": "EV production was twice as high as in 2015."
        },
        {
          "id": "a6-approximately",
          "type": "word",
          "term": "approximately",
          "variants": [
            "roughly"
          ],
          "meaning": "about",
          "example": "Roughly 40% of people lived in rural areas."
        },
        {
          "id": "a6-per-capita",
          "type": "word",
          "term": "per capita",
          "meaning": "per person",
          "example": "Income per capita rose to $8,000."
        },
        {
          "id": "a6-ratio",
          "type": "word",
          "term": "ratio",
          "meaning": "relationship between two numbers",
          "example": "The male-to-female ratio was 3:1."
        },
        {
          "id": "a6-aggregate",
          "type": "word",
          "term": "aggregate",
          "meaning": "total",
          "example": "The aggregate number of visitors was 50,000."
        },
        {
          "id": "a6-respectively",
          "type": "word",
          "term": "respectively",
          "meaning": "in the same order",
          "example": "Men and women spent $80 and $90 respectively."
        }
      ],
      "phrases": [
        "a small fraction",
        "a tiny minority",
        "the vast majority",
        "just over half",
        "nearly a third",
        "in the region of 56%",
        "one in ten",
        "one in a hundred"
      ]
    },
    {
      "id": "A7",
      "title": "Comparing and Contrasting",
      "entries": [
        {
          "id": "a7-surpass",
          "type": "word",
          "term": "surpass",
          "variants": [
            "exceed"
          ],
          "meaning": "be more than",
          "example": "Female employment surpassed male employment in 2018."
        },
        {
          "id": "a7-overtake",
          "type": "word",
          "term": "overtake",
          "meaning": "pass (a rising line)",
          "example": "Solar power overtook coal in 2021."
        },
        {
          "id": "a7-outnumber",
          "type": "word",
          "term": "outnumber",
          "meaning": "be more in number",
          "example": "Female athletes outnumbered male athletes."
        },
        {
          "id": "a7-outpace",
          "type": "word",
          "term": "outpace",
          "meaning": "grow faster than",
          "example": "Car sales outpaced motorbike sales."
        },
        {
          "id": "a7-dominate",
          "type": "word",
          "term": "dominate",
          "variants": [
            "predominate"
          ],
          "meaning": "be the largest",
          "example": "Online shopping dominated retail spending."
        },
        {
          "id": "a7-predominantly",
          "type": "word",
          "term": "predominantly",
          "meaning": "mainly, largely",
          "example": "The workforce was predominantly male."
        },
        {
          "id": "a7-widen",
          "type": "word",
          "term": "widen",
          "variants": [
            "narrow the gap"
          ],
          "meaning": "increase / reduce the difference",
          "example": "The gap between the two cities narrowed after 2010."
        },
        {
          "id": "a7-converge",
          "type": "word",
          "term": "converge",
          "variants": [
            "diverge"
          ],
          "meaning": "come together / move apart",
          "example": "The two lines converged in 2015."
        },
        {
          "id": "a7-in-comparison-to",
          "type": "word",
          "term": "in comparison to",
          "variants": [
            "with"
          ],
          "meaning": "compared with",
          "example": "Scores were higher in comparison with 2019."
        },
        {
          "id": "a7-by-contrast",
          "type": "word",
          "term": "by contrast",
          "variants": [
            "conversely"
          ],
          "meaning": "on the other hand",
          "example": "Smoking decreased; conversely, vaping increased."
        },
        {
          "id": "a7-whereas",
          "type": "word",
          "term": "whereas",
          "variants": [
            "while"
          ],
          "meaning": "but (joining two clauses)",
          "example": "Urban populations grew, whereas rural ones shrank."
        }
      ]
    },
    {
      "id": "A8",
      "title": "Time Phrases",
      "phrases": [
        "over the period shown",
        "over the course of a decade",
        "throughout the period",
        "during the following years",
        "by 2020",
        "from 2000 onwards",
        "at the start / end of the period"
      ]
    }
